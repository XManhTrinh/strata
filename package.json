{
  "name": "strata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public --schema app > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@windmorph/react": "^0.1.1",
    "@windmorph/react-pro": "github:XManhTrinh/windmorph-pro#6ee20a907b3c3b3cb57c4d7829f122d6e51e7e05",
    "material-symbols": "^0.48.2",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "^5.0.5"
  }
}
