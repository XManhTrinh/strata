generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

// ─── API Key Model ──────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String
  userId     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id])
}

// ─── Core Identity Models ───────────────────────────────────────────────────────

model Person {
  id          String     @id @default(cuid())
  fullName    String
  dateOfBirth DateTime
  email       String
  phone       String?
  address     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?
}

// ─── Engineering Hierarchy Models ───────────────────────────────────────────────

// ─── Auth & Access Control Models ───────────────────────────────────────────────

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  supabaseUserId  String?          @unique
  personId        String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  person          Person           @relation(fields: [personId], references: [id])
  apiKeys         ApiKey[]
}

// ═══════════════════════════════════════════════════════════════════════════════
// Permission System — Scalable Dynamic Authorization
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum PermissionScope {
  OWN
  DIRECT_REPORTS
  ORGANIZATION_UNIT
  BRANCH
  COMPANY
  GLOBAL
}

// ─── Company (extends Organization concept) ─────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizationUnitTypes  OrganizationUnitType[]
  organizationUnits      OrganizationUnit[]
  positions              Position[]
  roles                  Role[]
  users                  UserCompanyMembership[]
  features               CompanyFeature[]
  reportingRelationships ReportingRelationship[]
  careerLevelScheme      CareerLevelScheme?

  // Calendar & Leave relations
  eventTypes         EventType[]
  leaveTypeConfigs   LeaveTypeConfig[]
  calendarEvents     CalendarEvent[]

  // Legacy link (migration bridge)
  legacyOrganizationId String? @unique

  // Table views
  tableViews             TableView[]
}

// ─── Table Views (saved column configurations per company) ──────────────────────

model TableView {
  id        String   @id @default(cuid())
  companyId String
  name      String   // "Default", "HR View", "Finance View"
  table     String   // "members", "capacity", etc.
  columns   Json     // ["fullName", "email", "metadata.Division", "metadata.Grade"]
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, table, name])
}

// ─── Organization Unit Types ────────────────────────────────────────────────────

model OrganizationUnitType {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  description  String?
  icon         String?
  color        String?
  displayOrder Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company            @relation(fields: [companyId], references: [id])
  units   OrganizationUnit[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
}

// ─── Organization Units (replaces Department) ───────────────────────────────────

model OrganizationUnit {
  id         String    @id @default(cuid())
  companyId  String
  typeId     String
  name       String
  code       String?
  parentId   String?
  sortOrder  Int       @default(0)
  managerId  String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Materialized path for fast ancestor/descendant queries
  path String @default("/")

  company  Company              @relation(fields: [companyId], references: [id])
  type     OrganizationUnitType @relation(fields: [typeId], references: [id])
  parent   OrganizationUnit?    @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[]   @relation("OrgUnitHierarchy")

  members UserCompanyMembership[] @relation("UserOrgUnit")

  @@index([companyId, parentId])
  @@index([companyId, typeId])
  @@index([companyId, path])
  @@index([managerId])
}

// ─── Career Level Scheme (company-configurable leveling system) ──────────────────

model CareerLevelScheme {
  id          String   @id @default(cuid())
  companyId   String   @unique
  type        String   @default("numeric") // "numeric" | "alphabetic" | "custom"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  levels  CareerLevel[]
}

model CareerLevel {
  id          String   @id @default(cuid())
  schemeId    String
  rank        Int      // sort order / numeric rank for comparisons
  label       String   // "L1", "A", "IC3", "M2", etc.
  displayName String?  // "Junior", "Senior", "Staff", etc.
  track       String?  // "IC" | "Management" | null (for dual-track)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scheme    CareerLevelScheme      @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  positions Position[]           @relation("PositionLevel")
  positionsMin Position[]        @relation("PositionMinLevel")
  positionsMax Position[]        @relation("PositionMaxLevel")
  users     UserCompanyMembership[]

  @@unique([schemeId, label])
  @@index([schemeId])
}

// ─── Positions (company-scoped) ─────────────────────────────────────────────────

model Position {
  id                   String    @id @default(cuid())
  companyId            String
  name                 String
  description          String?
  minLevelId           String?   // minimum career level for this position
  maxLevelId           String?   // maximum career level for this position
  careerLevelId        String?   // @deprecated — use minLevelId/maxLevelId
  careerLevel          Int?      // @deprecated — use career level scheme
  canHaveDirectReports Boolean   @default(false)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  minLevel     CareerLevel?  @relation("PositionMinLevel", fields: [minLevelId], references: [id])
  maxLevel     CareerLevel?  @relation("PositionMaxLevel", fields: [maxLevelId], references: [id])
  level        CareerLevel?  @relation("PositionLevel", fields: [careerLevelId], references: [id])
  users        UserCompanyMembership[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
  @@index([minLevelId])
  @@index([maxLevelId])
}

// ─── Reporting Relationships (independent of org unit) ──────────────────────────

model ReportingRelationship {
  id        String   @id @default(cuid())
  companyId String
  userId    String   @unique // Each user has at most one manager
  managerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, managerId])
  @@index([companyId, userId])
}

// ─── User-Company Membership (multi-tenant user context) ────────────────────────

model UserCompanyMembership {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  positionId     String?
  orgUnitId      String?
  careerLevelId  String?  // person's actual career level within position range
  isSuperAdmin   Boolean  @default(false)
  employmentType String?  // "Perm" or "SubCon"
  annualSalary   Decimal? @db.Decimal(12, 2) // for Perm employees
  dayRate        Decimal? @db.Decimal(10, 2) // for SubCon — annual cost = dayRate × 228
  metadata       Json?    @default("{}") // flexible key-value store for CSV import fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company         Company           @relation(fields: [companyId], references: [id])
  position        Position?         @relation(fields: [positionId], references: [id])
  orgUnit         OrganizationUnit? @relation("UserOrgUnit", fields: [orgUnitId], references: [id])
  careerLevel     CareerLevel?      @relation(fields: [careerLevelId], references: [id])
  roleAssignments RoleAssignment[]

  @@unique([userId, companyId])
  @@index([companyId, orgUnitId])
  @@index([companyId, isSuperAdmin])
  @@index([careerLevelId])
}

// ─── Roles (company-scoped) ─────────────────────────────────────────────────────

model Role {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
}

// ─── Features (platform-level registry) ─────────────────────────────────────────

model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  displayName String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions FeaturePermission[]
  companies   CompanyFeature[]
}

model FeaturePermission {
  id           String    @id @default(cuid())
  featureId    String
  key          String
  displayName  String
  description  String?
  deprecatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  feature         Feature          @relation(fields: [featureId], references: [id])
  roleAssignments RolePermission[]

  @@unique([featureId, key])
}

// ─── Company-Feature enablement ─────────────────────────────────────────────────

model CompanyFeature {
  id        String   @id @default(cuid())
  companyId String
  featureId String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([companyId, featureId])
}

// ─── Role-Permission Assignment (the core tuple) ────────────────────────────────

model RolePermission {
  id                  String            @id @default(cuid())
  roleId              String
  featurePermissionId String
  scope               PermissionScope
  createdAt           DateTime          @default(now())

  role              Role              @relation(fields: [roleId], references: [id])
  featurePermission FeaturePermission @relation(fields: [featurePermissionId], references: [id])

  @@unique([roleId, featurePermissionId, scope])
  @@index([roleId])
  @@index([featurePermissionId])
}

// ─── Role Assignment (user ↔ role within company) ───────────────────────────────

model RoleAssignment {
  id           String   @id @default(cuid())
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedBy   String?

  membership UserCompanyMembership @relation(fields: [membershipId], references: [id])
  role       Role                  @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Calendar & Leave Module
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Calendar Enums ─────────────────────────────────────────────────────────────

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum EventVisibility {
  PERSONAL
  SHARED
}

// ─── Event Type (company-configurable) ──────────────────────────────────────────

model EventType {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  color       String    @default("#3B82F6")
  icon        String?
  description String?
  isSystem    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company   @relation(fields: [companyId], references: [id])
  events      CalendarEvent[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
}

// ─── Leave Type (company-configurable) ──────────────────────────────────────────

model LeaveTypeConfig {
  id                String    @id @default(cuid())
  companyId         String
  name              String
  color             String    @default("#10B981")
  defaultAllocation Decimal   @db.Decimal(5, 1)
  requiresApproval  Boolean   @default(true)
  carryOver         Boolean   @default(false)
  maxCarryOverDays  Decimal?  @db.Decimal(5, 1)
  isSystem          Boolean   @default(false)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company           Company   @relation(fields: [companyId], references: [id])
  balances          LeaveBalance[]
  requests          CalendarLeaveRequest[]
  accrualPolicies   AccrualPolicy[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
}

// ─── Calendar Event ─────────────────────────────────────────────────────────────

model CalendarEvent {
  id              String          @id @default(cuid())
  companyId       String
  ownerUserId     String
  eventTypeId     String
  title           String
  startDate       DateTime
  endDate         DateTime
  allDay          Boolean         @default(false)
  visibility      EventVisibility @default(SHARED)
  notes           String?

  // Recurrence fields
  isRecurring         Boolean              @default(false)
  recurrenceMasterId  String?
  recurrenceFrequency RecurrenceFrequency?
  recurrenceDaysOfWeek Int[]
  recurrenceDayOfMonth Int?
  recurrenceEndDate   DateTime?
  recurrenceCount     Int?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company          Company         @relation(fields: [companyId], references: [id])
  eventType        EventType       @relation(fields: [eventTypeId], references: [id])
  recurrenceMaster CalendarEvent?  @relation("RecurrenceInstances", fields: [recurrenceMasterId], references: [id])
  instances        CalendarEvent[] @relation("RecurrenceInstances")
  leaveRequest     CalendarLeaveRequest?

  @@index([companyId, ownerUserId, startDate, endDate])
  @@index([companyId, startDate, endDate])
  @@index([recurrenceMasterId])
}

// ─── Leave Request (extends CalendarEvent) ──────────────────────────────────────

model CalendarLeaveRequest {
  id              String             @id @default(cuid())
  calendarEventId String             @unique
  leaveTypeId     String
  status          LeaveRequestStatus @default(PENDING)
  workingDays     Decimal            @db.Decimal(4, 1)
  reviewerId      String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  calendarEvent   CalendarEvent      @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  leaveType       LeaveTypeConfig    @relation(fields: [leaveTypeId], references: [id])

  @@index([leaveTypeId, status])
  @@index([calendarEventId])
}

// ─── Leave Balance ──────────────────────────────────────────────────────────────

model LeaveBalance {
  id            String   @id @default(cuid())
  companyId     String
  userId        String
  leaveTypeId   String
  year          Int
  allocated     Decimal  @db.Decimal(5, 1)
  used          Decimal  @db.Decimal(5, 1) @default(0)
  adjustment    Decimal  @db.Decimal(5, 1) @default(0)
  carriedOver   Decimal  @db.Decimal(5, 1) @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leaveType     LeaveTypeConfig @relation(fields: [leaveTypeId], references: [id])

  @@unique([companyId, userId, leaveTypeId, year])
  @@index([companyId, userId, year])
}

// ─── Accrual Policy ─────────────────────────────────────────────────────────────

model AccrualPolicy {
  id              String   @id @default(cuid())
  companyId       String
  leaveTypeId     String
  monthlyAccrual  Decimal  @db.Decimal(4, 2)
  maxAccumulation Decimal? @db.Decimal(5, 1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leaveType       LeaveTypeConfig @relation(fields: [leaveTypeId], references: [id])

  @@unique([companyId, leaveTypeId])
  @@index([companyId, isActive])
}
