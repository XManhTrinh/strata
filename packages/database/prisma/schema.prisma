generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

// ─── API Key Model ──────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String
  userId     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id])
}

// ─── Core Identity Models ───────────────────────────────────────────────────────

model Person {
  id          String     @id @default(cuid())
  fullName    String
  dateOfBirth DateTime
  email       String
  phone       String?
  address     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?
}

// ─── Auth & Access Control Models ───────────────────────────────────────────────

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  supabaseUserId  String?          @unique
  personId        String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  person          Person           @relation(fields: [personId], references: [id])
  apiKeys         ApiKey[]
  notifications   Notification[]
}

// ═══════════════════════════════════════════════════════════════════════════════
// Permission System — Scalable Dynamic Authorization
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum PermissionScope {
  OWN
  DIRECT_REPORTS
  ORGANIZATION_UNIT
  BRANCH
  COMPANY
  GLOBAL
}

// ─── Company (extends Organization concept) ─────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizationUnitTypes  OrganizationUnitType[]
  organizationUnits      OrganizationUnit[]
  positions              Position[]
  roles                  Role[]
  users                  UserCompanyMembership[]
  features               CompanyFeature[]
  reportingRelationships ReportingRelationship[]
  careerLevelScheme      CareerLevelScheme?

  // Calendar & Leave relations
  eventTypes         EventType[]
  leaveTypeConfigs   LeaveTypeConfig[]
  calendarEvents     CalendarEvent[]

  // Legacy link (migration bridge)
  legacyOrganizationId String? @unique

  // Table views
  tableViews             TableView[]

  // Capacity planning
  capacityAllocations    CapacityAllocation[]
  rateCards              RateCard[]
  rateCardGroups         RateCardGroup[]
  rateCardSets           RateCardSet[]
  notifications          Notification[]
}

// ─── Table Views (saved column configurations per company) ──────────────────────

model TableView {
  id        String   @id @default(cuid())
  companyId String
  name      String   // "Default", "HR View", "Finance View"
  table     String   // "members", "capacity", etc.
  columns   Json     // ["fullName", "email", "metadata.Division", "metadata.Grade"]
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, table, name])
}

// ─── Organization Unit Types ────────────────────────────────────────────────────

model OrganizationUnitType {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  description  String?
  icon         String?
  color        String?
  displayOrder Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company            @relation(fields: [companyId], references: [id])
  units   OrganizationUnit[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
}

// ─── Organization Units (replaces Department) ───────────────────────────────────

model OrganizationUnit {
  id         String    @id @default(cuid())
  companyId  String
  typeId     String
  name       String
  code       String?
  parentId   String?
  sortOrder  Int       @default(0)
  managerId  String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Materialized path for fast ancestor/descendant queries
  path String @default("/")

  company  Company              @relation(fields: [companyId], references: [id])
  type     OrganizationUnitType @relation(fields: [typeId], references: [id])
  parent   OrganizationUnit?    @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[]   @relation("OrgUnitHierarchy")

  members UserCompanyMembership[] @relation("UserOrgUnit")
  capacityAllocations CapacityAllocation[]

  @@index([companyId, parentId])
  @@index([companyId, typeId])
  @@index([companyId, path])
  @@index([managerId])
}

// ─── Career Level Scheme (company-configurable leveling system) ──────────────────

model CareerLevelScheme {
  id          String   @id @default(cuid())
  companyId   String   @unique
  type        String   @default("numeric") // "numeric" | "alphabetic" | "custom"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  levels  CareerLevel[]
}

model CareerLevel {
  id          String   @id @default(cuid())
  schemeId    String
  rank        Int      // sort order / numeric rank for comparisons
  label       String   // "L1", "A", "IC3", "M2", etc.
  displayName String?  // "Junior", "Senior", "Staff", etc.
  track       String?  // "IC" | "Management" | null (for dual-track)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scheme    CareerLevelScheme      @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  positions Position[]           @relation("PositionLevel")
  positionsMin Position[]        @relation("PositionMinLevel")
  positionsMax Position[]        @relation("PositionMaxLevel")
  users     UserCompanyMembership[]

  @@unique([schemeId, label])
  @@index([schemeId])
}

// ─── Positions (company-scoped) ─────────────────────────────────────────────────

model Position {
  id                   String    @id @default(cuid())
  companyId            String
  name                 String
  description          String?
  minLevelId           String?   // minimum career level for this position
  maxLevelId           String?   // maximum career level for this position
  careerLevelId        String?   // @deprecated — use minLevelId/maxLevelId
  careerLevel          Int?      // @deprecated — use career level scheme
  canHaveDirectReports Boolean   @default(false)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  minLevel     CareerLevel?  @relation("PositionMinLevel", fields: [minLevelId], references: [id])
  maxLevel     CareerLevel?  @relation("PositionMaxLevel", fields: [maxLevelId], references: [id])
  level        CareerLevel?  @relation("PositionLevel", fields: [careerLevelId], references: [id])
  users        UserCompanyMembership[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
  @@index([minLevelId])
  @@index([maxLevelId])
}

// ─── Reporting Relationships (independent of org unit) ──────────────────────────

model ReportingRelationship {
  id        String   @id @default(cuid())
  companyId String
  userId    String   @unique // Each user has at most one manager
  managerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, managerId])
  @@index([companyId, userId])
}

// ─── User-Company Membership (multi-tenant user context) ────────────────────────

model UserCompanyMembership {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  positionId     String?
  orgUnitId      String?
  careerLevelId  String?  // person's actual career level within position range
  isSuperAdmin   Boolean  @default(false)
  employmentType String?  // "Perm" or "SubCon"
  annualSalary   Decimal? @db.Decimal(12, 2) // for Perm employees
  dayRate        Decimal? @db.Decimal(10, 2) // for SubCon — annual cost = dayRate × 228
  metadata       Json?    @default("{}") // flexible key-value store for CSV import fields

  // Rate card application snapshot (set by "apply rate cards"). The capacity
  // view reads these; they only change when rate cards are re-applied.
  appliedRateCardId String?
  /// Snapshot of the applied per-period monthly cost at 1.0 FTE:
  /// { "p1": 3800, ..., "p12": 3800 }. Null until a card is applied.
  appliedCost       Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company         Company           @relation(fields: [companyId], references: [id])
  position        Position?         @relation(fields: [positionId], references: [id])
  orgUnit         OrganizationUnit? @relation("UserOrgUnit", fields: [orgUnitId], references: [id])
  careerLevel     CareerLevel?      @relation(fields: [careerLevelId], references: [id])
  roleAssignments RoleAssignment[]
  capacityAllocations CapacityAllocation[]

  @@unique([userId, companyId])
  @@index([companyId, orgUnitId])
  @@index([companyId, isSuperAdmin])
  @@index([careerLevelId])
}

// ─── Roles (company-scoped) ─────────────────────────────────────────────────────

model Role {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
}

// ─── Features (platform-level registry) ─────────────────────────────────────────

model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  displayName String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions FeaturePermission[]
  companies   CompanyFeature[]
}

model FeaturePermission {
  id           String    @id @default(cuid())
  featureId    String
  key          String
  displayName  String
  description  String?
  deprecatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  feature         Feature          @relation(fields: [featureId], references: [id])
  roleAssignments RolePermission[]

  @@unique([featureId, key])
}

// ─── Company-Feature enablement ─────────────────────────────────────────────────

model CompanyFeature {
  id        String   @id @default(cuid())
  companyId String
  featureId String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([companyId, featureId])
}

// ─── Role-Permission Assignment (the core tuple) ────────────────────────────────

model RolePermission {
  id                  String            @id @default(cuid())
  roleId              String
  featurePermissionId String
  scope               PermissionScope
  createdAt           DateTime          @default(now())

  role              Role              @relation(fields: [roleId], references: [id])
  featurePermission FeaturePermission @relation(fields: [featurePermissionId], references: [id])

  @@unique([roleId, featurePermissionId, scope])
  @@index([roleId])
  @@index([featurePermissionId])
}

// ─── Role Assignment (user ↔ role within company) ───────────────────────────────

model RoleAssignment {
  id           String   @id @default(cuid())
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedBy   String?

  membership UserCompanyMembership @relation(fields: [membershipId], references: [id])
  role       Role                  @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Calendar & Leave Module
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Calendar Enums ─────────────────────────────────────────────────────────────

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum EventVisibility {
  PERSONAL
  SHARED
}

// ─── Event Type (company-configurable) ──────────────────────────────────────────

model EventType {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  color       String    @default("#3B82F6")
  icon        String?
  description String?
  isSystem    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company   @relation(fields: [companyId], references: [id])
  events      CalendarEvent[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
}

// ─── Leave Type (company-configurable) ──────────────────────────────────────────

model LeaveTypeConfig {
  id                String    @id @default(cuid())
  companyId         String
  name              String
  color             String    @default("#10B981")
  defaultAllocation Decimal   @db.Decimal(5, 1)
  requiresApproval  Boolean   @default(true)
  carryOver         Boolean   @default(false)
  maxCarryOverDays  Decimal?  @db.Decimal(5, 1)
  isSystem          Boolean   @default(false)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company           Company   @relation(fields: [companyId], references: [id])
  balances          LeaveBalance[]
  requests          CalendarLeaveRequest[]
  accrualPolicies   AccrualPolicy[]

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
}

// ─── Calendar Event ─────────────────────────────────────────────────────────────

model CalendarEvent {
  id              String          @id @default(cuid())
  companyId       String
  ownerUserId     String
  eventTypeId     String
  title           String
  startDate       DateTime
  endDate         DateTime
  allDay          Boolean         @default(false)
  visibility      EventVisibility @default(SHARED)
  notes           String?

  // Recurrence fields
  isRecurring         Boolean              @default(false)
  recurrenceMasterId  String?
  recurrenceFrequency RecurrenceFrequency?
  recurrenceDaysOfWeek Int[]
  recurrenceDayOfMonth Int?
  recurrenceEndDate   DateTime?
  recurrenceCount     Int?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company          Company         @relation(fields: [companyId], references: [id])
  eventType        EventType       @relation(fields: [eventTypeId], references: [id])
  recurrenceMaster CalendarEvent?  @relation("RecurrenceInstances", fields: [recurrenceMasterId], references: [id])
  instances        CalendarEvent[] @relation("RecurrenceInstances")
  leaveRequest     CalendarLeaveRequest?

  @@index([companyId, ownerUserId, startDate, endDate])
  @@index([companyId, startDate, endDate])
  @@index([recurrenceMasterId])
}

// ─── Leave Request (extends CalendarEvent) ──────────────────────────────────────

model CalendarLeaveRequest {
  id              String             @id @default(cuid())
  calendarEventId String             @unique
  leaveTypeId     String
  status          LeaveRequestStatus @default(PENDING)
  workingDays     Decimal            @db.Decimal(4, 1)
  reviewerId      String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  calendarEvent   CalendarEvent      @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  leaveType       LeaveTypeConfig    @relation(fields: [leaveTypeId], references: [id])

  @@index([leaveTypeId, status])
  @@index([calendarEventId])
}

// ─── Leave Balance ──────────────────────────────────────────────────────────────

model LeaveBalance {
  id            String   @id @default(cuid())
  companyId     String
  userId        String
  leaveTypeId   String
  year          Int
  allocated     Decimal  @db.Decimal(5, 1)
  used          Decimal  @db.Decimal(5, 1) @default(0)
  adjustment    Decimal  @db.Decimal(5, 1) @default(0)
  carriedOver   Decimal  @db.Decimal(5, 1) @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leaveType     LeaveTypeConfig @relation(fields: [leaveTypeId], references: [id])

  @@unique([companyId, userId, leaveTypeId, year])
  @@index([companyId, userId, year])
}

// ─── Accrual Policy ─────────────────────────────────────────────────────────────

model AccrualPolicy {
  id              String   @id @default(cuid())
  companyId       String
  leaveTypeId     String
  monthlyAccrual  Decimal  @db.Decimal(4, 2)
  maxAccumulation Decimal? @db.Decimal(5, 1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leaveType       LeaveTypeConfig @relation(fields: [leaveTypeId], references: [id])

  @@unique([companyId, leaveTypeId])
  @@index([companyId, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Capacity Planning Module
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Capacity Allocation (per-person FTE phasing) ───────────────────────────────
// One row per person × org unit × fiscal year.
// p1–p12 represent FTE allocation (0.0 to 1.0) per period.
// A person can appear in multiple squads (split allocation).

model CapacityAllocation {
  id          String   @id @default(cuid())
  companyId   String
  membershipId String  // UserCompanyMembership ID
  orgUnitId   String   // Squad / org unit this allocation is for
  fiscalYear  Int      // e.g. 2025, 2026

  // Monthly FTE allocation (0.0 = not present, 0.5 = half, 1.0 = full)
  p1  Decimal @db.Decimal(3, 2) @default(0)
  p2  Decimal @db.Decimal(3, 2) @default(0)
  p3  Decimal @db.Decimal(3, 2) @default(0)
  p4  Decimal @db.Decimal(3, 2) @default(0)
  p5  Decimal @db.Decimal(3, 2) @default(0)
  p6  Decimal @db.Decimal(3, 2) @default(0)
  p7  Decimal @db.Decimal(3, 2) @default(0)
  p8  Decimal @db.Decimal(3, 2) @default(0)
  p9  Decimal @db.Decimal(3, 2) @default(0)
  p10 Decimal @db.Decimal(3, 2) @default(0)
  p11 Decimal @db.Decimal(3, 2) @default(0)
  p12 Decimal @db.Decimal(3, 2) @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id])
  membership UserCompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  orgUnit    OrganizationUnit  @relation(fields: [orgUnitId], references: [id])

  @@unique([companyId, membershipId, orgUnitId, fiscalYear])
  @@index([companyId, orgUnitId, fiscalYear])
  @@index([companyId, fiscalYear])
}

// ─── Rate Cards (self-contained: conditions + per-quarter day rate × days) ──────
//
// A rate card is a single rule that both SELECTS members (via `conditions`) and
// COMPUTES their cost (via per-quarter day rate × working days). No separate
// lookup table.
//
//   conditions — [{ column, operator, value }] ANDed together, matched against a
//                member's imported columns (typed fields + CSV metadata).
//   qN rate    — each quarter has a day rate and working-days-per-month; the
//                quarter's monthly cost = dayRate × workingDays, and the annual
//                cost = sum of (each quarter's monthly cost × 3).
//
// Users manage cards on the rate-cards page, then APPLY selected cards to
// matching members. Applying snapshots the resolved per-period cost onto the
// membership (`appliedCost`), which the capacity view reads. Editing a card does
// not change capacity numbers until it is re-applied.

/// Condition operator for a rate card's matching conditions.
enum RateCardRuleOperator {
  EQUALS
  NOT_EQUALS
  STARTS_WITH
  STARTS_WITH_ANY // value is a comma-separated list of prefixes; matches if the column starts with any
  ENDS_WITH
  CONTAINS
  IN
}

/// Top-level, UI-only container shown as a tab (e.g. "Digital"). Holds groups.
/// Purely organizational — does not affect matching.
model RateCardSet {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  description  String?
  color        String? // hex, e.g. "#3B82F6" — UI accent for the tab
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id])
  groups  RateCardGroup[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// A named, UI-only container for organizing rate cards (e.g. "Actuals",
/// "Recharge"). Optionally nested inside a set (tab). Purely organizational —
/// does not affect matching.
model RateCardGroup {
  id          String   @id @default(cuid())
  companyId   String
  /// Optional parent set (tab). Ungrouped-by-set when null.
  setId       String?
  name        String
  description String?
  color       String?  // hex, e.g. "#3B82F6" — UI accent for the group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id])
  set     RateCardSet? @relation(fields: [setId], references: [id], onDelete: SetNull)
  cards   RateCard[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([setId])
}

model RateCard {
  id        String  @id @default(cuid())
  companyId String
  name      String
  /// Optional UI grouping. Ungrouped when null.
  groupId   String?
  /// Lower runs first. Cards are evaluated top-down; first match wins.
  priority  Int     @default(0)
  /// When true this card matches any member not matched by an earlier card.
  isDefault Boolean @default(false)

  /// Array of conditions ANDed together:
  /// [{ "column": "Capex/Opex", "operator": "EQUALS", "value": "Opex" }, ...]
  conditions Json @default("[]")

  // Per-quarter inputs. Monthly cost for a quarter = dayRate × workingDays.
  q1DayRate     Decimal? @db.Decimal(12, 2)
  q1WorkingDays Decimal? @db.Decimal(6, 2)
  q2DayRate     Decimal? @db.Decimal(12, 2)
  q2WorkingDays Decimal? @db.Decimal(6, 2)
  q3DayRate     Decimal? @db.Decimal(12, 2)
  q3WorkingDays Decimal? @db.Decimal(6, 2)
  q4DayRate     Decimal? @db.Decimal(12, 2)
  q4WorkingDays Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id])
  group   RateCardGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([companyId, name])
  @@index([companyId, priority])
  @@index([groupId])
}


// ─── Notifications ──────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  type      String   // e.g. "import_complete", "import_error", "system"
  title     String
  message   String
  metadata  Json?    @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([companyId, userId])
}
