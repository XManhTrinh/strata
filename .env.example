# Copy to .env.local and fill in. Local values come from `supabase status -o env`.

# Supabase project URL and publishable (anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in for the local Supabase stack (optional). Read by supabase/config.toml; put them
# in supabase/.env, not here.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Outgoing email (server only). Locally: Mailpit from `supabase start` (open http://127.0.0.1:54324).
# Staging/production: the email provider's SMTP URL, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM="Strata <no-reply@strata.local>"
