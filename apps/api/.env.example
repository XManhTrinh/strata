# =============================================================================
# Strata API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# Server
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/strata?schema=public"

# CORS — Origin allowed for cross-origin requests from the frontend
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=your-jwt-secret-here

# Redis — Used for session/token storage
REDIS_URL=redis://localhost:6379

# Frontend URL — Used for OAuth/SSO callback redirects
FRONTEND_URL=http://localhost:3000

# Google OAuth — Used for Google sign-in
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
