# =============================================================================
# Strata API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# Server
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/strata?schema=public"

# CORS — Origin allowed for cross-origin requests from the frontend
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=your-jwt-secret-here

# Redis — Used for session/token storage
REDIS_URL=redis://localhost:6379

# Frontend URL — Used for OAuth/SSO callback redirects
FRONTEND_URL=http://localhost:3000

# Google OAuth — Used for Google sign-in
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# AI Assistant (Google Gemini) — server-only; never expose to the frontend
# Get a key from Google AI Studio (https://aistudio.google.com). Do NOT commit a real key.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional fallback model, tried only if the primary keeps failing. Leave empty
# unless you have a dependable second model — sibling flash models can 404/503
# intermittently. The provider already retries the primary on transient errors.
GEMINI_FALLBACK_MODEL=
# Max tool calls the assistant may run per user message
ASSISTANT_MAX_TOOL_CALLS=6
# Timeout for a single LLM request (ms)
ASSISTANT_REQUEST_TIMEOUT_MS=30000
# Per-user assistant requests allowed per minute
ASSISTANT_RATE_LIMIT_PER_MIN=20
