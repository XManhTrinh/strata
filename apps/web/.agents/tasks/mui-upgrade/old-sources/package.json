{
  "name": "@vkieu/mui",
  "version": "1.0.0",
  "description": "Material Design 3 Expressive component library for React & Next.js",
  "packageManager": "pnpm@9.15.4",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm --filter @vkieu/mui-docs build",
    "docs:dev": "pnpm --filter @vkieu/mui-docs dev"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./themes": "./src/themes/index.ts",
    "./themes/theme-blue.css": "./src/themes/theme-blue.css",
    "./themes/theme-teal.css": "./src/themes/theme-teal.css",
    "./themes/theme-green.css": "./src/themes/theme-green.css",
    "./themes/theme-red.css": "./src/themes/theme-red.css",
    "./themes/theme-amber.css": "./src/themes/theme-amber.css",
    "./themes/theme-facebook.css": "./src/themes/theme-facebook.css",
    "./themes/theme-whatsapp.css": "./src/themes/theme-whatsapp.css",
    "./buttons": "./src/buttons/index.ts",
    "./navigation": "./src/navigation/index.ts",
    "./sheets": "./src/sheets/index.ts",
    "./indicators": "./src/indicators/index.ts",
    "./pickers": "./src/pickers/index.ts"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "material-design-3",
    "m3-expressive",
    "react",
    "nextjs",
    "tailwindcss",
    "ui-components",
    "design-system"
  ],
  "license": "MIT",
  "files": [
    "src"
  ]
}
